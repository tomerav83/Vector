<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>
	<groupId>com.vector</groupId>
	<artifactId>vector</artifactId>
	<version>0.1.0</version>
	<name>Airport Investment Intelligence Agent</name>

	<properties>
		<java.version>25</java.version>
		<spring-ai.version>2.0.2</spring-ai.version>
		<duckdb.version>2.0.0.1</duckdb.version>
		<jsoup.version>1.23.2</jsoup.version>
		<tika.version>4.2.0</tika.version>
		<!-- Tests tagged "live" hit real public APIs; they run only in the manual live-data workflow. -->
		<excludedGroups>live</excludedGroups>
		<spotless.version>3.11.0</spotless.version>
		<palantir-java-format.version>2.103.0</palantir-java-format.version>
		<jacoco.version>0.8.16</jacoco.version>
		<!-- DuckDB's JDBC driver loads native code; without this, Java 25 warns at every start and test run. -->
		<native-access>--enable-native-access=ALL-UNNAMED</native-access>
		<!-- The tests' JVM; JaCoCo adds its agent in front. -->
		<argLine>${native-access}</argLine>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Operations: the `data` endpoint (status, refresh) and its health, on a local-only management port. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Downloads: RestClient with Boot's HTTP client settings (spring.http.clients.*). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<!-- Database: jOOQ is the abstraction (dialect is config); DuckDB is the default engine. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jooq</artifactId>
		</dependency>
		<dependency>
			<groupId>org.duckdb</groupId>
			<artifactId>duckdb_jdbc</artifactId>
			<version>${duckdb.version}</version>
		</dependency>

		<!-- LLM: Spring AI ChatClient is the abstraction; pick the provider with spring.ai.model.chat.
		     Adding a provider = adding its starter, plus its block in application.yml. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-google-genai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-anthropic</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-chat-memory</artifactId>
		</dependency>
		<!-- The agent's tools as an MCP server too, so Claude Code or any MCP client can ask them without an API key. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>

		<!-- HTML parser for form pages whose hidden fields must be posted back (BTS TranStats, ASP.NET). -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>${jsoup.version}</version>
		</dependency>

		<!-- Tells a file's type by its first bytes, e.g. a web page served where a CSV was expected. -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
		</dependency>

		<!-- IDE completion and docs for vector.data.* in application-<country>.yml (the field docs of DataProperties). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<!-- No test mocks: they use fakes (FakeSite, ScriptedModel). Leaving Mockito out also drops its agent warning. -->
			<exclusions>
				<exclusion>
					<groupId>org.mockito</groupId>
					<artifactId>mockito-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.mockito</groupId>
					<artifactId>mockito-junit-jupiter</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Java 23+ runs annotation processors only when asked: the configuration processor above. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<proc>full</proc>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<jvmArguments>${native-access}</jvmArguments>
				</configuration>
			</plugin>
			<!-- jOOQ's classes of the tables and views (package view), generated at each build from schema.sql and views.sql
			     run on an empty in-memory DuckDB: a query naming a column the SQL lacks fails the compile. -->
			<plugin>
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.duckdb</groupId>
						<artifactId>duckdb_jdbc</artifactId>
						<version>${duckdb.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<jdbc>
						<driver>org.duckdb.DuckDBDriver</driver>
						<url>jdbc:duckdb:memory:codegen;session_init_sql_file=${project.basedir}/src/main/resources/sql/schema.sql</url>
						<initScript>${project.basedir}/src/main/resources/sql/views.sql</initScript>
						<!-- A statement ends with ; at the end of a line, as data.Script splits them. -->
						<initSeparator>;[ \t]*(?:--[^\n]*)?\r?\n</initSeparator>
					</jdbc>
					<generator>
						<database>
							<name>org.jooq.meta.duckdb.DuckDBDatabase</name>
							<inputCatalog>memory</inputCatalog>
							<inputSchema>main</inputSchema>
							<outputCatalogToDefault>true</outputCatalogToDefault>
							<outputSchemaToDefault>true</outputSchemaToDefault>
							<!-- DuckDB sums a BIGINT into a HUGEINT, which jOOQ does not know. -->
							<forcedTypes>
								<forcedType>
									<name>BIGINT</name>
									<includeTypes>HUGEINT</includeTypes>
								</forcedType>
							</forcedTypes>
						</database>
						<generate>
							<!-- No Tables or Keys class beside data.Tables: each table class holds its own reference. -->
							<globalObjectReferences>false</globalObjectReferences>
						</generate>
						<target>
							<packageName>com.vector.airport.view</packageName>
						</target>
					</generator>
				</configuration>
			</plugin>
			<!-- Coverage: `verify` fails under 90% of lines or 85% of branches; the report is target/site/jacoco. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<exclude>com/vector/airport/view/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.90</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.85</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Formatting: `mvn spotless:apply` fixes, `verify` (CI) fails on unformatted code. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<!-- `// spotless:off` ... `// spotless:on` keeps hand-aligned blocks (e.g. jOOQ/SQL chains) as written. -->
						<toggleOffOn/>
						<!-- Palantir sorts imports itself, so no importOrder step (it would fight the formatter). -->
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
							<style>PALANTIR</style>
							<formatJavadoc>true</formatJavadoc>
						</palantirJavaFormat>
						<removeUnusedImports/>
						<forbidWildcardImports/>
						<forbidModuleImports/>
					</java>
					<!-- Non-Java text files: no trailing whitespace, final newline. -->
					<formats>
						<format>
							<includes>
								<include>*.md</include>
								<include>.gitignore</include>
								<include>.github/**/*.yml</include>
								<include>src/main/resources/**/*.yml</include>
								<include>src/main/resources/**/*.yaml</include>
								<include>src/main/resources/**/*.properties</include>
							</includes>
							<trimTrailingWhitespace/>
							<endWithNewline/>
						</format>
					</formats>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>